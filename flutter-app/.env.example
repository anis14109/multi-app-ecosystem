# Flutter environment configuration (flutter_dotenv)
#
# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored and never committed; `.env.example` is the tracked template.
#
# API_BASE_URL is the root URL of the Laravel API (everything before /api/v1/...).
# APP_NAME is the display name shown throughout the UI.
# APP_ENV is informational only: development | staging | production.
API_BASE_URL=http://192.168.0.151/multi-app-ecosystem/laravel-api/api
APP_NAME=MultiApp
APP_ENV=development